  "endpoint": "GET /v1/embassies?nationality=SA&destination=GB",
  "response": {
    "missions": [
      {
        "nationality_code": "SA",
        "destination_code": "GB",
        "official_name": "Embassy name as published by the issuing government",
        "city": "London",
        "address": "Officially published street address",
        "phone": "+0000000000",
        "emergency_phone": null,
        "email": null,
        "website": "https://official-government-domain.example",
        "working_hours": null,
        "source_url": "https://official-government-domain.example/mission-directory-entry",
        "verified_at": "YYYY-MM-DD",
        "is_officially_verified": true
